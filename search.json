---
layout: null
---



[
  {% for post in site.posts %}
    {% unless post.search_exclude %}
      {
        "title"    : "{{ post.title | escape }}",
        "category" : "{{ post.category | }}",
        "tags"     : "{{ post.tags | join: ', ' }}",
        "url"      : "{{ site.baseurl }}{{ post.url }}",
        "date"     : "{{ post.date }}"
      }{% unless forloop.last %},{% endunless %}
    {% endunless %}
  {% endfor %}
]